<mxfile host="app.diagrams.net">
  <diagram name="Day 3 - Red Team">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- CENTER -->
        <mxCell id="center"
          value="DAY 3&#10;ATTACK OUR OWN PROBLEM"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2937;fontColor=#FFFFFF;strokeColor=#111827;strokeWidth=3;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="360" height="100" as="geometry"/>
        </mxCell>

        <!-- CLAIM 1 -->
        <mxCell id="claim1"
          value="CLAIM 1&#10;Existing systems expose&#10;sensitive evidence"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;fontColor=#991B1B;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="250" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="result1"
          value="RED TEAM RESULT&#10;&#10;FALSE AS STATED&#10;&#10;Encryption&#10;Access control&#10;RBAC&#10;Audit logs&#10;Controlled sharing"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;fontSize=13;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="25" y="180" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- CLAIM 2 -->
        <mxCell id="claim2"
          value="CLAIM 2&#10;Blockchain systems expose&#10;sensitive metadata"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;fontColor=#92400E;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="270" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="result2"
          value="RED TEAM RESULT&#10;&#10;SOME EVIDENCE&#10;&#10;B-CoC can expose custody relationships.&#10;&#10;e-CoC / LEChain use off-chain or privacy mechanisms."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontSize=13;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="335" y="180" width="300" height="130" as="geometry"/>
        </mxCell>

        <!-- CLAIM 3 -->
        <mxCell id="claim3"
          value="CLAIM 3&#10;ZKP solves the&#10;remaining problem"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;fontColor=#991B1B;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="250" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="result3"
          value="RED TEAM RESULT&#10;&#10;ASSUMPTION&#10;&#10;ZKP can prove selected statements privately.&#10;&#10;It does NOT prove real-world truth or admissibility by itself."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;fontSize=13;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="660" y="180" width="290" height="130" as="geometry"/>
        </mxCell>

        <!-- CLAIM 4 -->
        <mxCell id="claim4"
          value="CLAIM 4&#10;Courts actually&#10;need this"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;fontColor=#92400E;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="70" width="230" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="result4"
          value="RED TEAM RESULT&#10;&#10;SOME EVIDENCE&#10;&#10;Courts care about authentication, integrity, provenance and reliability.&#10;&#10;No proof courts specifically require SSI/ZKP."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontSize=13;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="975" y="180" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- CLAIM 5 -->
        <mxCell id="claim5"
          value="CLAIM 5&#10;Commercial products&#10;don't solve it"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;fontColor=#92400E;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="250" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="result5"
          value="RED TEAM RESULT&#10;&#10;SOME EVIDENCE — ONLY AFTER NARROWING&#10;&#10;Guardian, Axon, FTK, etc. already solve major parts of integrity, privacy, access and CoC.&#10;&#10;Cross-platform verification remains a hypothesis."
