          vertex="1" parent="1">
          <mxGeometry x="380" y="430" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="survivedText"
          value="Evidence integrity matters&#10;&#10;Chain of custody matters&#10;&#10;Authentication matters&#10;&#10;Multiple organizations may need to trust records&#10;&#10;Minimum disclosure may be useful"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=13;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="510" width="310" height="180" as="geometry"/>
        </mxCell>

        <!-- KILLED -->
        <mxCell id="killed"
          value="ASSUMPTIONS KILLED"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;fontColor=#991B1B;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=17;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="killedText"
          value="Systems expose evidence&#10;Blockchain always leaks metadata&#10;ZKP solves everything&#10;Courts require ZKP&#10;Commercial products are inadequate"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;fontSize=13;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="675" y="510" width="300" height="180" as="geometry"/>
        </mxCell>

        <!-- REVISED -->
        <mxCell id="revised"
          value="REVISED HYPOTHESIS"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;fontColor=#075985;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=17;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="1010" y="430" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="revisedText"
          value="Existing systems are strong within their governed platforms.&#10;&#10;OPEN QUESTION: Can independent organizations verify evidence provenance, actor authorization and custody across platform boundaries without unnecessary disclosure?"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#7DD3FC;fontSize=13;align=center;verticalAlign=middle;spacing=8;"
          vertex="1" parent="1">
          <mxGeometry x="990" y="510" width="290" height="180" as="geometry"/>
        </mxCell>

        <!-- DAY 4 -->
        <mxCell id="day4"
          value="DAY 4&#10;&#10;Does this cross-organization gap actually exist?&#10;&#10;Who experiences it?&#10;How often?&#10;What solutions already exist?"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#FFFFFF;strokeColor=#000000;strokeWidth=3;fontStyle=1;fontSize=17;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="760" width="420" height="130" as="geometry"/>
        </mxCell>

        <!-- CONNECTORS -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="center" target="claim1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="center" target="claim2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="center" target="claim3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="center" target="claim4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="center" target="claim5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;" edge="1" parent="1" source="claim1" target="result1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;" edge="1" parent="1" source="claim2" target="result2"><mxGeometry relative="1" as="geometry"/></mxCell>
